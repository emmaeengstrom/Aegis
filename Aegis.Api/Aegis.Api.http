@Aegis.Api_HostAddress = https://localhost:7269

@token = 
@token2 = 

### =========================
### AUTHENTICATION
### =========================


### Register user 1
POST {{Aegis.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "emma@example.com",
  "password": "SecurePassword123!"
}


### Login user 1
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "EMma@eXample.com",
  "password": "SecurePassword123!"
}


### Invalid login
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "emma@example.com",
  "password": "WrongPassword123!"
}


### Register user 2
POST {{Aegis.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "SecurePassword456!"
}


### Login user 2
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "SecurePassword456!"
}


### =========================
### PROJECTS - USER 1
### =========================


### Get user 1 projects
GET {{Aegis.Api_HostAddress}}/api/projects
Accept: application/json
Authorization: Bearer {{token}}


### Get project by ID
GET {{Aegis.Api_HostAddress}}/api/projects/3
Accept: application/json
Authorization: Bearer {{token}}


### Create project
POST {{Aegis.Api_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Aegis Security Project",
  "description": "Project owned by the authenticated user"
}


### Update project
PUT {{Aegis.Api_HostAddress}}/api/projects/3
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Aegis Security Project Updated",
  "description": "Updated by the project owner"
}


### Delete project
DELETE {{Aegis.Api_HostAddress}}/api/projects/3
Authorization: Bearer {{token}}


### =========================
### AUTHORIZATION TESTS
### =========================


### User 2 tries to read user 1 project
GET {{Aegis.Api_HostAddress}}/api/projects/3
Accept: application/json
Authorization: Bearer {{token2}}


### User 2 tries to update user 1 project
PUT {{Aegis.Api_HostAddress}}/api/projects/3
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "name": "Unauthorized update",
  "description": "This request should not succeed"
}


### User 2 tries to delete user 1 project
DELETE {{Aegis.Api_HostAddress}}/api/projects/3
Authorization: Bearer {{token2}}


### =========================
### VALIDATION TESTS
### =========================


### Missing project name
POST {{Aegis.Api_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "description": "This request should fail because name is missing"
}


### =========================
### AUTHENTICATION TESTS
### =========================


### Try accessing projects without token
GET {{Aegis.Api_HostAddress}}/api/projects
Accept: application/json

### User 1 adds user 2 as project member
POST {{Aegis.Api_HostAddress}}/api/projects/3/members
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "user2@example.com"
} 

### User 2 tries to add a member to user 1 project
POST {{Aegis.Api_HostAddress}}/api/projects/3/members
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "email": "emma@example.com"
}

### User 2 reads project as member
GET {{Aegis.Api_HostAddress}}/api/projects/3
Accept: application/json
Authorization: Bearer {{token2}} 

### User 2 lists accessible projects
GET {{Aegis.Api_HostAddress}}/api/projects
Accept: application/json
Authorization: Bearer {{token2}}

### User 2 tries to update project
PUT {{Aegis.Api_HostAddress}}/api/projects/3
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "name": "Unauthorized update",
  "description": "This should still fail"
}

### User 1 lists project members
GET {{Aegis.Api_HostAddress}}/api/projects/3/members
Accept: application/json
Authorization: Bearer {{token}} 

### User 2 tries to list project members
GET {{Aegis.Api_HostAddress}}/api/projects/3/members
Accept: application/json
Authorization: Bearer {{token2}}