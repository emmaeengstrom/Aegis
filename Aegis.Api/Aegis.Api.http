@Aegis.Api_HostAddress = https://localhost:7269

@token =
@token2 =
@token3 =

@projectId = 3
@user2Id = 2


### =========================
### AUTHENTICATION
### =========================

### Register user 1
POST {{Aegis.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "emma@example.com",
  "password": "SecurePassword123!"
}


### Login user 1
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "emma@example.com",
  "password": "SecurePassword123!"
}


### Register user 2
POST {{Aegis.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "SecurePassword456!"
}


### Login user 2
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "SecurePassword456!"
}


### Invalid login
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "emma@example.com",
  "password": "WrongPassword123!"
}


### Access protected endpoint without token
GET {{Aegis.Api_HostAddress}}/api/projects
Accept: application/json


### =========================
### PROJECTS
### =========================

### Get accessible projects - user 1
GET {{Aegis.Api_HostAddress}}/api/projects
Accept: application/json
Authorization: Bearer {{token}}


### Get project by ID - user 1
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json
Authorization: Bearer {{token}}


### Create project
POST {{Aegis.Api_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Aegis Security Project",
  "description": "Project owned by the authenticated user"
}


### Update project as owner
PUT {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Aegis Security Project Updated",
  "description": "Updated by the project owner"
}


### =========================
### VALIDATION
### =========================

### Missing project name
POST {{Aegis.Api_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "description": "This request should fail because name is missing"
}


### =========================
### PROJECT MEMBERS
### =========================

### Add user 2 as Viewer
POST {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "user2@example.com",
  "role": "Viewer"
}


### List project members as owner
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members
Accept: application/json
Authorization: Bearer {{token}}


### Member cannot list project members
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members
Accept: application/json
Authorization: Bearer {{token2}}


### Try to assign forbidden Owner role
POST {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "user2@example.com",
  "role": "Owner"
}


### =========================
### VIEWER AUTHORIZATION
### =========================

### Viewer can read project
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json
Authorization: Bearer {{token2}}


### Viewer can list accessible projects
GET {{Aegis.Api_HostAddress}}/api/projects
Accept: application/json
Authorization: Bearer {{token2}}


### Viewer cannot update project
PUT {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "name": "Viewer should not update this",
  "description": "This request should be blocked."
}


### Viewer cannot delete project
DELETE {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{token2}}


### =========================
### ROLE MANAGEMENT
### =========================

### Owner changes user 2 to Editor
PUT {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members/{{user2Id}}/role
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "role": "Editor"
}


### Verify user 2 role
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members
Accept: application/json
Authorization: Bearer {{token}}


### =========================
### EDITOR AUTHORIZATION
### =========================

### Editor can update project
PUT {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "name": "Updated by Editor",
  "description": "This project was updated by user2 with the Editor role."
}


### Verify Editor update
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json
Authorization: Bearer {{token2}}


### =========================
### PRIVILEGE ESCALATION TESTS
### =========================

### Owner changes user 2 back to Viewer
PUT {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members/{{user2Id}}/role
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "role": "Viewer"
}


### User 2 cannot promote themselves to Editor
PUT {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members/{{user2Id}}/role
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "role": "Editor"
}


### =========================
### AUDIT LOGS
### =========================

### Owner reads project audit logs
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/audit-logs
Accept: application/json
Authorization: Bearer {{token}}


### Viewer reads project audit logs
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/audit-logs
Accept: application/json
Authorization: Bearer {{token2}}


### =========================
### OUTSIDER AUTHORIZATION
### =========================

### Register user 3
POST {{Aegis.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "user3@example.com",
  "password": "SecurePassword789!"
}


### Login user 3
POST {{Aegis.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "user3@example.com",
  "password": "SecurePassword789!"
}


### Outsider cannot read project
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json
Authorization: Bearer {{token3}}


### Outsider cannot read project audit logs
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/audit-logs
Accept: application/json
Authorization: Bearer {{token3}}


### =========================
### MEMBER REMOVAL
### =========================

### Owner removes user 2
DELETE {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/members/{{user2Id}}
Authorization: Bearer {{token}}


### Removed user can no longer read project
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json
Authorization: Bearer {{token2}}


### Removed user can no longer read audit logs
GET {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}/audit-logs
Accept: application/json
Authorization: Bearer {{token2}}


### =========================
### DESTRUCTIVE PROJECT TEST
### RUN ONLY WHEN NEEDED
### =========================

### Delete project as owner
DELETE {{Aegis.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}